{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-mailbox",
  "main": "src/worker.js",
  "define": { "__dirname": "\"/\"" },
  "alias": {
    "./proxy.js": "./egress/proxy-worker.js",
    "../egress/proxy.js": "./egress/proxy-worker.js",
    "./crypto/poly1305.js": "./node_modules/ssh2/lib/protocol/crypto/poly1305.worker.js",
    "./vendor/chacha20poly1305.js": "./node_modules/tunnelfetch/src/profile/vendor/chacha20poly1305.worker.js",
    "./vendor/mlkem768.js": "./node_modules/tunnelfetch/src/profile/vendor/mlkem768.worker.js",
    "./vendor/brotli-dec.js": "./node_modules/tunnelfetch/src/profile/vendor/brotli-dec.worker.js",
    "./vendor/zstd-dec.js": "./node_modules/tunnelfetch/src/profile/vendor/zstd-dec.worker.js",
    "cpu-features": "./src/no-native.cjs",
    "./crypto/build/Release/sshcrypto.node": "./src/no-native.cjs"
  },
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node scripts/prepare-worker.mjs" },
  "workers_dev": false,
  "preview_urls": false,
  "browser": { "binding": "BROWSER" },
  "vars": { "HTTP_TARGETS": "{}", "SSH_TARGETS": "{}", "BROWSER_TARGETS": "{}" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "edge-mailbox",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["* * * * *"] }
}
