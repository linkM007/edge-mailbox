{
  "name": "edge-mailbox",
  "version": "0.2.0",
  "private": true,
  "description": "Authenticated Cloudflare HTTP jobs and D1 mailbox for predefined remote operations",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --test-scheduled",
    "test": "node --test --test-concurrency=1",
    "build": "wrangler deploy --dry-run --outdir dist",
    "cli": "node cli/main.js",
    "browser:capture": "node --env-file=.env.egress egress/capture.js",
    "proxy:check": "node --env-file=.env.egress egress/check-proxy.js",
    "db:local": "wrangler d1 migrations apply edge-mailbox --local",
    "pretest": "npm run build",
    "check": "npm test"
  },
  "dependencies": {
    "@cloudflare/playwright": "1.3.6",
    "playwright-core": "1.65.0",
    "ssh2": "1.17.0",
    "tunnelfetch": "1.13.1",
    "undici": "8.12.4"
  },
  "devDependencies": {
    "miniflare": "5.20261104.0-beta",
    "wrangler": "4.158.0"
  }
}
